{
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "incremental": true
  },
  "references": [
    {
      "path": "./packages/admin"
    },
    {
      "path": "./packages/website"
    },
    {
      "path": "./packages/server"
    }
  ]
}
